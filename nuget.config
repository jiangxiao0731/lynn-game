<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Godot.NET.Sdk 4.7.0 ships inside the Godot 4.7 .NET editor and is not published
      on nuget.org. The packages are vendored under ./nupkgs and referenced by a path
      relative to this file, so the project restores on any machine. Pointing at the
      editor's own install directory only worked on the machine it was written on.
    -->
    <add key="godot-local" value="nupkgs" />
  </packageSources>
</configuration>
