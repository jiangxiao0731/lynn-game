; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shallow Sea Dream"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

Events="*res://scripts/Events.cs"
AudioManager="*res://scripts/AudioManager.cs"
SaveManager="*res://scripts/SaveManager.cs"
MemoryLog="*res://scripts/MemoryLog.cs"
WindowManager="*res://scripts/WindowManager.cs"
PauseInput="*res://scripts/PauseInput.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[dotnet]

project/assembly_name="ShallowSeaDream"

[gui]

theme/custom="res://assets/ui_theme.tres"

